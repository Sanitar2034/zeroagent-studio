# =============================================================================
# .cursorignore — ZeroAgent Studio
# =============================================================================
# Files Cursor must NOT load into context. Standard gitignore syntax.
# Same goal as the legacy .gitignore rules for AI artifacts, plus the
# build/test/runtime noise that pollutes context without helping edits.
#
# IMPORTANT — track on purpose, do NOT add here:
#   .cursor/rules/**        Shared agent playbooks (loaded by description)
#   .cursor/skills/**       Portable workflow skills
#
# Companion files:
#   .gitignore              What Git must not track
#   .kilocodeignore         Mirror for Kilo Code (legacy ignore)
#   .kilo/kilo.jsonc        Kilo config (permissions, agents, instructions)
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies & build artifacts (large, regenerated, never source-of-truth)
# -----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
out/
.vite/
.turbo/
.cache/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/

# Source maps & TS build info (regenerated on every build)
*.map
*.tsbuildinfo
.eslintcache
.prettiercache
.stylelintcache

# -----------------------------------------------------------------------------
# Ephemeral AI assistant state — local only, regenerated every session
# -----------------------------------------------------------------------------
# Cursor plans / scratchpads
.cursor/plans/
.cursor/scratch/
.cursor/snapshots/
.cursor/worktrees/
.claude/plans/
**/plans/
**/plan.md
**/plans.md
**/*-plan.md
**/*-plans.md
**/plan-*.md
**/plans-*.md
**/EXECUTION_PLAN.md
**/execution-plan.md

# Kilo local sandbox (worktrees, agent-manager state, plans)
.kilo/plans/
.kilo/worktrees/
.kilo/agent-manager.json
.kilo/sessions/
.kilo/logs/
.kilo/scratch/
.kilo/snapshots/

# Cross-agent ephemeral state
.claude/plans/
.claude/settings.local.json
.aider*
.aider.chat.history*

# -----------------------------------------------------------------------------
# Local sandbox state (debugging helpers, MCP snapshots, ephemeral data)
# -----------------------------------------------------------------------------
.playwright-mcp/
.mcp/
.tmp/
tmp/
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Secrets & credentials — defense in depth even though .gitignore also blocks
# -----------------------------------------------------------------------------
.env
.env.*
.envrc
!.env.example
*.pem
*.key
*.p12
*.pfx
*id_rsa*
*id_ed25519*
*id_ecdsa*
*.gpg
*.asc
.netrc
.aws/
.gcp/
.azure/
.gcloud/
.ssh/
credentials/
secrets/

# -----------------------------------------------------------------------------
# Logs & debug noise
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuild.log

# -----------------------------------------------------------------------------
# Test artifacts & coverage
# -----------------------------------------------------------------------------
coverage/
coverage-out.txt
test-results/
playwright-report/
playwright/.cache/
.vitest-cache/
cypress/videos/
cypress/screenshots/
lcov.info

# -----------------------------------------------------------------------------
# IDE & OS noise (keep shared editorconfig + .vscode/extensions.json tracked)
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/
