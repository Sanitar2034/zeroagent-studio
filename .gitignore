# =============================================================================
# .gitignore — ZeroAgent Studio
# =============================================================================
# Tracked on purpose:
#   .cursor/rules/        Shared Cursor agent playbooks (.mdc)
#   .cursor/skills/       Shared Cursor workflow skills (SKILL.md)
#   .kilo/kilo.jsonc      Kilo central config (no secrets, schema-driven)
#   .kilo/rules/          Shared Kilo architecture & quality rules (.md)
#   .kilo/skills/         Shared Kilo workflow skills (SKILL.md)
#   .kilo/agents/         Shared Kilo personas with permissions
#   .kilo/command/        Shared Kilo slash commands
# Ignored: ephemeral AI state under .cursor/plans/, .kilo/plans/,
#          .kilo/worktrees/, .kilo/agent-manager.json — see CONTRIBUTING.md.

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
coverage/
coverage-out.txt

# Environment & secrets
.env
.env.local
.env.*.local
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# Tool caches
*.tsbuildinfo
.eslintcache
.prettiercache
*.map

# Vitest / test artifacts
test-results/
html-report/
playwright-report/

# Kilo local sandbox — track shared config, ignore ephemeral state
.kilo/*
!.kilo/kilo.jsonc
!.kilo/kilo.json
!.kilo/rules/
!.kilo/rules/**
!.kilo/skills/
!.kilo/skills/**
!.kilo/agents/
!.kilo/agents/**
!.kilo/command/
!.kilo/command/**
!.kilo/commands/
!.kilo/commands/**

# Cursor — track shared rules/skills, ignore ephemeral state
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**

# AI-generated plans (ephemeral — regenerated by assistants)
.cursor/plans/
.cursor/scratch/
.cursor/snapshots/
.cursor/worktrees/
.kilo/plans/
.kilo/worktrees/
.kilo/sessions/
.kilo/logs/
.kilo/scratch/
.kilo/snapshots/
.kilo/agent-manager.json
.claude/plans/
.claude/settings.local.json
.aider*
.aider.chat.history*
**/plans/
**/plan.md
**/plans.md
**/*-plan.md
**/*-plans.md
**/plan-*.md
**/plans-*.md
**/EXECUTION_PLAN.md
**/execution-plan.md

# Playwright MCP snapshots
.playwright-mcp/

# Secrets & credential material — defense in depth
#   (these are also blocked in .cursorignore and .kilocodeignore so the
#   coding agents never see them, and deny-listed in .kilo/kilo.jsonc)
*id_rsa*
*id_ed25519*
*id_ecdsa*
*.gpg
*.asc
.netrc
.aws/
.gcp/
.azure/
.gcloud/
.ssh/
.config/gh/hosts.yml

# Temporary
tmp/
*.tmp
